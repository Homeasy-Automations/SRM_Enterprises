# ---------------------------------------------------------------------------
# SRM Enterprises web app — environment template
# Copy to `.env.local` (git-ignored) and fill in real values.
# All URLs must be WITHOUT a trailing slash.
# ---------------------------------------------------------------------------

# Base URL of the Express API (services/api).
# Local development: http://localhost:5000
# Production: the public API origin, e.g. https://api.your-domain.com
# Leave EMPTY to call the API relatively on this origin (/api/...) — correct when a
# reverse proxy puts the API on the same domain, or when API_PROXY_TARGET is set below.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Public site URL, used for canonical URLs, sitemap, robots and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# Digits only, including country code, no "+" and no spaces. e.g. 919876543210
# Used to build https://wa.me/<number>. If empty, the WhatsApp and Call buttons are
# hidden site-wide instead of linking to an invalid number.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Display phone number shown in the UI. Leave empty to hide call buttons.
NEXT_PUBLIC_PHONE_NUMBER=+91 XXXXX XXXXX

# Optional analytics — each is loaded only when the ID is present.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ---------------------------------------------------------------------------
# Server-side only (NOT exposed to the browser)
# ---------------------------------------------------------------------------
# Optional same-origin API proxy: when set, this Next app proxies /api/* to the API.
# Useful on a single-domain deployment, or to make a sandbox/preview fully functional.
# API_PROXY_TARGET=http://localhost:5000
