# ---------------------------------------------------------------------------
# SRM Enterprises API — environment template
# Copy to `.env` and fill in real values. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string.
# TODO: replace <user>, <password> and <cluster> with your Atlas values.
# Least privilege: this DB user only needs readWrite on the site database.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/srm-enterprises?retryWrites=true&w=majority

# Allowed browser origins, comma separated. Include BOTH www and apex variants.
# Trailing slashes are stripped automatically. www/apex variants are expanded automatically.
CLIENT_URL=http://localhost:3000,https://www.your-domain.com,https://your-domain.com

# Resend (https://resend.com) — the ONLY email transport used (SMTP ports are blocked on many hosts).
# TODO: replace with your real API key.
RESEND_API_KEY=re_your_resend_api_key
# Must be an address on a domain VERIFIED in Resend (otherwise Resend only delivers to the signup address).
RESEND_FROM_EMAIL=SRM Enterprises <noreply@your-domain.com>
# Where inquiry notifications should land (sales inbox).
CONTACT_RECEIVER_EMAIL=info@your-domain.com

# Salt used to hash visitor IPs (never store the raw IP). Use a long random string.
IP_HASH_SALT=change-me-to-a-long-random-string

# Optional
LOG_LEVEL=info
TRUST_PROXY=1
