26:{"slug":"pharmaceuticals","name":"Pharmaceuticals","shortName":"Pharmaceuticals","tagline":"Clean, dust-free packing for sensitive products and equipment","description":"Packaging for pharma packaging lines, equipment, glassware and consumables.","intro":"Pharma requirements are shaped by cleanliness and consistency. Packing materials should not shed dust, should keep items sealed and should arrive to the same specification every time the packing line runs.","challenges":"$27","recommendedPackaging":"$28","approach":"$2d","supplyNotes":"$2e","color":"#19B26B","icon":"pharma","imageKey":"industryPharma"}
