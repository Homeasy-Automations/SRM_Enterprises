nqrlb",{"d":"M14 2v4a2 2 0 0 0 2 2h4"}],["$","path","b1mrlr",{"d":"M10 9H8"}],["$","path","t4e002",{"d":"M16 13H8"}],["$","path","z1uh3a",{"d":"M16 17H8"}],"$undefined"]}]}],["$","h3",null,{"className":"font-ui text-lg font-bold text-navy sm:text-xl","children":"7. Cookies and analytics"}]]}],["$","div",null,{"className":"mt-4 flex flex-col gap-3","children":[["$","p","This website does not require cookies for you to use the form. If analytics identifiers are configured by the site owner (Google Analytics, Google Tag Manager or Meta Pixel), those tools may set their own cookies to measure aggregate site usage. Those integrations are only loaded when an identifier has been configured, and they are not used to build a personal profile of you on this site.",{"className":"text-sm leading-relaxed text-navy-soft sm:text-base","children":"This website does not require cookies for you to use the form. If analytics identifiers are configured by the site owner (Google Analytics, Google Tag Manager or Meta Pixel), those tools may set their own cookies to measure aggregate site usage. Those integrations are only loaded when an identifier has been configured, and they are not used to build a personal profile of you on this site."}],["$","p","Your colour-mood preference on this site is held in memory only for your current visit; it is not stored in cookies or local storage.",{"className":"text-sm leading-relaxed text-navy-soft sm:text-base","children":"Your colour-mood preference on this site is held in memory only for your current visit; it is not stored in cookies or local storage."}]]}],null]}]}],["$","$L4","your-rights",{"variant":"fade-up","delay":0.2,"className":"scroll-mt-28","children":["$","article",null,{"id":"your-rights","className":"rounded-[26px] border border-navy/10 bg-white p-6 shadow-soft sm:p-7","children":[["$","div",null,{"className":"flex items-center gap-3","children":[["$","span",null,{"className":"grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-acc