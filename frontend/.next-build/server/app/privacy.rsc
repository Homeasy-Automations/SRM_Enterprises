n":[["$","path","1rqfz7",{"d":"M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"}],["$","path","tnqrlb",{"d":"M14 2v4a2 2 0 0 0 2 2h4"}],["$","path","b1mrlr",{"d":"M10 9H8"}],["$","path","t4e002",{"d":"M16 13H8"}],["$","path","z1uh3a",{"d":"M16 17H8"}],"$undefined"]}]}],["$","h3",null,{"className":"font-ui text-lg font-bold text-navy sm:text-xl","children":"4. Email notifications"}]]}],["$","div",null,{"className":"mt-4 flex flex-col gap-3","children":[["$","p","When you submit the form, the inquiry is stored in our database and two emails are sent through our email provider (Resend): one notification to our sales inbox, and one confirmation to the email address you provided. The confirmation email contains a summary of what you submitted so you have a record of it.",{"className":"text-sm leading-relaxed text-navy-soft sm:text-base","children":"When you submit the form, the inquiry is stored in our database and two emails are sent through our email provider (Resend): one notification to our sales inbox, and one confirmation to the email address you provided. The confirmation email contains a summary of what you submitted so you have a record of it."}],["$","p","If you did not submit an inquiry and received a confirmation email, reply to that email and we will remove the record from our systems.",{"className":"text-sm leading-relaxed text-navy-soft sm:text-base","children":"If you did not submit an inquiry and received a confirmation email, reply to that email and we will remove the record from our systems."}]]}],null]}]}],["$","$L4","storage-security",{"variant":"fade-up","delay":0.16,"className":"scroll-mt-28","children":["$","article",null,{"id":"storage-security","className":"rounded-[26px] border border-navy/10 bg-white p-6 shadow-soft sm:p-7","children":[["$","div",null,{"className":"flex items-center gap-3","children":[["$","span",null,{"className":"grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-accent-soft text-accent-deep","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-file-text h-4 w-4","aria-hidden":"true","children":[["$","path","1rqfz7",{"d":"M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"}],["$","path","tnqrlb",{"d":"M14 2v4a2 2 0 0 0 2 2h4"}],["$","path","b1mrlr",{"d":"M10 9H8"}],["$","path","t4e002",{"d":"M16 13H8"}],["$","path","z1uh3a",{"d":"M16 17H8"}],"$undefined"]}]}],["$","h3",null,{"className":"font-ui text-lg font-bold text-navy sm:text-xl","children":"5. Storage, retention and security"}]]}],["$","div",null,{"className":"mt-4 flex flex-col gap-3","children":[["$","p","Submitted inquiries are stored in a managed MongoDB Atlas database and are accessible only to authorised SRM Enterprises personnel through the database console. There are no public read, list, update or delete endpoints for inquiry data on this website — the API accepts submissions only.",{"className":"text-sm leading-relaxed text-navy-soft sm:text-base","children":"Submitted inquiries are stored in a managed MongoDB Atlas database and are accessible only to authorised SRM Enterprises personnel through the database console. There are no public read, list, update or delete endpoints for inquiry data on this website — the API accepts submissions only."}]]}],["$","ul",null,{"className":"mt-4 flex flex-col gap-2","children":[["$","li","Form traffic is transmitted over HTTPS and rate limited to prevent abuse",{"className":"flex items-start gap-2.5 text-sm leading-relaxed text-navy-soft","children":[["$","span",null,{"className":"mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent","aria-hidden":"true"}],["$","span",null,{"children":"Form traffic is transmitted over HTTPS and rate limited to prevent abuse"}]]}],["$","li","Submitted text is sanitised to prevent script injection",{"className":"flex items-start gap-2.5 text-sm leading-relaxed text-navy-soft","children":[["$","span",null,{"className":"mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent","aria-hidden":"true"}],["$","span",null,{"children":"Submitted text is sanitised to prevent script injection"}]]}],["$","li","We never store raw IP addresses; where abuse prevention requires it, only a salted one-way hash is kept",{"className":"flex items-start gap-2.5 text-sm leading-relaxed text-navy-soft","children":[["$","span",null,{"className":"mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent","aria-hidden":"true"}],["$","span",null,{"children":"We never store raw IP addresses; where abuse prevention requires it, only a salted one-way hash is kept"}]]}],["$","li","Inquiries are retained for as long as needed to serve the business relationship and applicable record-keeping duties",{"className":"flex items-start gap-2.5 text-sm leading-relaxed text-navy-soft","children":[["$","span",null,{"className":"mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent","aria-hidden":"true"}],["$","span",null,{"children":"Inquiries are retained for as long as needed to serve the business relationship and applicable record-keeping duties"}]]}]]}]]}]}],["$","$L4","sharing",{"variant":"fade-up","delay":0.2,"className":"scroll-mt-28","children":["$","article",null,{"id":"sharing","className":"rounded-[26px] border border-navy/10 bg-white p-6 shadow-soft sm:p-7","children":[["$","div",null,{"className":"flex items-center gap-3","children":[["$","span",null,{"className":"grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-accent-soft text-accent-deep","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-file-text h-4 w-4","aria-hidden":"true","children":[["$","path","1rqfz7",{"d":"M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"}],["$","path","tnqrlb",{"d":"M14 2v4