{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@srm/shared": ["../../packages/shared/src/index.ts"],
      "@srm/config": ["../../packages/config/src/index.ts"],
      "@srm/types": ["../../packages/types/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
